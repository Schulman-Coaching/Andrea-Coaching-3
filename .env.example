# Andrea Schulman Scheduling System - Environment Variables
# Copy this file to .env and fill in your actual values

# Application Environment
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/andrea_schulman_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=andrea_schulman_dev
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Stripe Payment Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email Service Configuration (SendGrid example)
EMAIL_SERVICE_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@andreaschulman.com
EMAIL_FROM_NAME=Andrea Schulman

# Admin Configuration
ADMIN_EMAIL=andrea@andreaschulman.com
ADMIN_PASSWORD=change_this_secure_password

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
API_URL=http://localhost:3001

# File Storage (AWS S3 example)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=andrea-schulman-assets

# Monitoring and Logging
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=info

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Session Configuration
SESSION_SECRET=your_session_secret_here
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Timezone Configuration
DEFAULT_TIMEZONE=America/New_York
ADMIN_TIMEZONE=Asia/Jerusalem

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_WAITLIST=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# Development Tools
DEBUG=app:*
ENABLE_SWAGGER=true
ENABLE_PLAYGROUND=true

# Testing Configuration
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/andrea_schulman_test
TEST_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key
TEST_STRIPE_SECRET_KEY=sk_test_your_test_key

# Production Overrides (uncomment for production)
# NODE_ENV=production
# DATABASE_URL=postgresql://user:password@prod-host:5432/andrea_schulman_prod
# REDIS_URL=redis://prod-redis:6379
# FRONTEND_URL=https://andreaschulman.com
# BACKEND_URL=https://api.andreaschulman.com
# CORS_ORIGIN=https://andreaschulman.com
# COOKIE_SECURE=true
# LOG_LEVEL=warn
# ENABLE_SWAGGER=false
# ENABLE_PLAYGROUND=false